# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Security & Authentication (Self-Hosted Fallback)
JWT_SECRET_KEY=clarityai_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default, or Supabase PostgreSQL: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres)
DATABASE_URL=sqlite:///./clarity_ai.db

# Supabase Auth & Cloud Configuration (Optional - set to enable Supabase managed auth and cloud storage)
USE_SUPABASE_AUTH=false
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-auto-confirm
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# File Storage
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
